msgstr ""

#: ../../FAQs.rst:46
msgid "How do I get started learning CharaChorder?"
msgstr ""

#: ../../FAQs.rst:47
msgid "Visit the learning page at: https://www.charachorder.com/pages/learn"
msgstr ""

#: ../../FAQs.rst:50
msgid "What is the learning curve like?"
msgstr ""

#: ../../FAQs.rst:51
msgid ""
"Most users surpass the average QWERTY speed (40 WPM) within about a month"
" of practice."
msgstr ""

