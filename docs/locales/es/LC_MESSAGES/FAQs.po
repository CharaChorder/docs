msgid "CharaChorder Two FAQs"
msgstr ""

#: ../../FAQs.rst:72
msgid "How do you access a full keyboard with fewer buttons?"
msgstr ""

#: ../../FAQs.rst:73
msgid ""
"The switches on a CharaChorder Two device are 3-dimensional, providing 5 "
"unique inputs per switch."
msgstr ""

