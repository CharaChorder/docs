#: ../../GenerativeTextMenu.rst:4
msgid "Generative Text Menu (GTM)"
msgstr ""

#: ../../GenerativeTextMenu.rst:6 ../../GenerativeTextMenu.rst:45
msgid ""
"``CharaChorder GTM [ >K<eyboard || >M<ouse || >C<hording || >D<isplay || "
